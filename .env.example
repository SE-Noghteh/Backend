APP_PORT=8081
# Docker port bindings and public S3 download URLs.
SERVER_IP=
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=
DB_NAME=zedlancer
DB_PORT=5432
SMS_TOKEN=
JWT_SECRET=
JWT_ISSUER=zedlancer
JWT_AUDIENCE=zedlancer-api
JWT_ACCESS_TOKEN_TTL=1h
S3_BUCKET=
AWS_REGION=us-east-1
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
# When the API runs in Docker, use a container-reachable endpoint.
# S3_DOCKER_ENDPOINT=http://host.docker.internal:9000
S3_USE_PATH_STYLE=false
# Use AWS credentials from environment, a profile, or an IAM role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
FFPROBE_PATH=ffprobe
