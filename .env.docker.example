# Set this once to the server's IP; port bindings and download URLs use it.
SERVER_IP=
DB_NAME=zedlancer
API_HOST_PORT=8081
DB_USER=zedlancer
DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
SMS_TOKEN=REPLACE_WITH_SMS_PROVIDER_TOKEN
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_ISSUER=zedlancer
JWT_AUDIENCE=zedlancer-api
JWT_ACCESS_TOKEN_TTL=1h
S3_BUCKET=zedlancer-local
AWS_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://${SERVER_IP}:9000
S3_USE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=REPLACE_WITH_LOCAL_STORAGE_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_RANDOM_LOCAL_STORAGE_SECRET
